{
  "expo": {
    "name": "Flat Expense Manager",
    "slug": "flat-expense-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "flatexpensemanager",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0C1A",
    "ios": {
      "bundleIdentifier": "com.flatmates.expensemanager",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Flat Expense Manager connects to the FastAPI backend and Ollama running on your laptop over the home Wi-Fi to read and save flat expenses.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoadsInWebContent": false
        }
      }
    },
    "android": {
      "package": "com.flatmates.expensemanager",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0E1A"
      }
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0C1A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2BD4BF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
